
//   _____ _____ _____ _____ _____ _____ _____ _____ _____
//  |   __|  _  |   __|_   _|   __|   __|_   _|     |  |  |
//  |   __|     |__   | | | |   __|   __| | | |   --|     |
//  |__|  |__|__|_____| |_| |__|  |_____| |_| |_____|__|__|  NYARCH
//

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.local/share/fastfetch/images/nyarch.png",
        "type": "kitty",
        "height": 14,
        "padding": {
            "top": 1,
            "right": 2
        }
    },
    "display": {
        "separator": "    ",
        "key": {
            "width":18
        }
    },
    "modules": [
        "break",
        {
            "type": "title",
            "format": "\u001b[35m caelestia\u001b[36m@\u001b[34mjoaocunha50"
        },
       {
            "type": "custom",
            "format": "╭─────────────────────────────────────────────────────────╮"
        },
        {
            "type": "os",
            "key": "│  OS",
            "keyColor": "blue"
        },
        {
            "type": "kernel",
            "key": "│  Kernel",
            "keyColor": "yellow"
        },
        {
            "type": "uptime",
            "key": "│  Uptime",
            "keyColor": "cyan"
        },
        {
            "type": "packages",
            "format": "{} (pacman)",
            "key": "│  Pkgs",
            "keyColor": "red"
        },
        {
            "type": "shell",
            "key": "│  Shell",
            "keyColor": "green"
        },
        {
            "type": "wm",
            "key": "│  WM",
            "keyColor": "magenta"
        },
        {
            "type": "terminal",
            "key": "│  Term",
            "keyColor": "cyan"
        },
        {
            "type": "memory",
            "key": "│  Memory",
            "keyColor": "blue"
        },
        {
            "type": "disk",
            "key": "│  Disk",
            "keyColor": "green",
            "folders": "/"
        },
        {
            "type": "custom",
            "format": "╰─────────────────────────────────────────────────────────╯"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
